# =============================================================================
# MXDP EdTech Platform - Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials
# =============================================================================

# -----------------------------------------------------------------------------
# SANITY.IO (Headless CMS) - Free Tier: 1M CDN req, 250k API req, 100 GB BW
# Dashboard: https://www.sanity.io/manage
# Docs: https://www.sanity.io/docs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# -----------------------------------------------------------------------------
# SUPABASE (PostgreSQL + Auth) - Free Tier: 500 MB DB, 5 GB egress, 50k MAU
# Dashboard: https://supabase.com/dashboard
# Docs: https://supabase.com/docs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# RESEND (Email API) - Free Tier: 3,000 emails/month, 100/day
# Dashboard: https://resend.com
# Docs: https://resend.com/docs
# Verify your domain before production use!
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@mxdp.id
ADMIN_EMAIL=admin@mxdp.id

# -----------------------------------------------------------------------------
# CLOUDINARY (Image/Video Management) - Free Tier: 25 credits/month
# Dashboard: https://cloudinary.com/console
# Docs: https://cloudinary.com/documentation
# Optional: Sanity handles images via CDN; Cloudinary for advanced transforms
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# LEAFLET + OPENSTREETMAP (Maps) - 100% Free, No API Key Required
# Tile server: https://tile.openstreetmap.org
# Policy: https://operations.osmfoundation.org/policies/tiles/
# No credentials needed - just configure coordinates in components
# -----------------------------------------------------------------------------
# No environment variables required for Leaflet/OSM

# -----------------------------------------------------------------------------
# VERCEL (Hosting) - Hobby: 100 GB BW, 1M fn inv, 45 min build
# Dashboard: https://vercel.com/dashboard
# Docs: https://vercel.com/docs
# Auto-configured on deploy; these are for local reference only
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VERCEL_URL=

# -----------------------------------------------------------------------------
# APP CONFIGURATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MXDP EdTech Platform

# -----------------------------------------------------------------------------
# GOOGLE SITE VERIFICATION (Optional - for Search Console)
# -----------------------------------------------------------------------------
GOOGLE_SITE_VERIFICATION=